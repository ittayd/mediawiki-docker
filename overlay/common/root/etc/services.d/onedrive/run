#!/usr/bin/with-contenv bash

export ROOT=/home/onedrive


function onedrive() {
  # turn on or off verbose logging
  if [ "$DEBUG" = "1" ]; then
    VERBOSE="-vvvv"
  fi

  exec su -s $(which onedrive) onedrive -- $VERBOSE --confdir=$ROOT/.config/onedrive --syncdir=$ROOT/OneDrive --single-directory MediawikiBackup "$@"
}

# The client refuses to run until a --resync has recorded the sync_list fingerprint,
# and it skips recording it on the run that signs in
function resync_flags() {
  local hash=$ROOT/.config/onedrive/.sync_list.hash
  if [ ! -s "$hash" ] || [ "$(cat "$hash")" = "initial-hash" ]; then
    echo "--resync --resync-auth"
  fi
}

function setup() {
  echo "Checking for refresh token..."
  # check a refresh token exists
  if [ -f $ROOT/.config/onedrive/refresh_token ]; then 
    echo "Found onedrive refresh token..."
    # the token may have been docker cp'ed in from a previous container
    chown -R onedrive:onedrive $ROOT
    if [ ! -d $ROOT/OneDrive/MediawikiBackup ] && [ -z "$SKIP_ONEDRIVE_INITIAL_SYNC" ]; then
      (onedrive --sync --download-only $(resync_flags))
    fi
  else
    echo
    echo "-------------------------------------"
    echo "ONEDRIVE LOGIN REQUIRED"
    echo "-------------------------------------"
    echo "To use this container you must authorize the OneDrive Client."

    if [ -t 0 ] ; then
      echo "-------------------------------------"
      echo
      [ -z "$SKIP_ONEDRIVE_INITIAL_SYNC" ] && SYNC="--sync --download-only"
      (onedrive $SYNC)
    else
      echo
      echo "Please re-start start the container in interactive mode using the -it flag:"
      echo
      echo "docker run -it $(hostname)"
      echo
      echo "Once authorized you can re-create container with interactive mode disabled."
      echo "-------------------------------------"
      echo
      exit 1
    fi

  fi
}

if [ "$1" = "setup" ]; then
  setup
  EC=$?
  echo "DONE"
  return $EC
fi

echo "Starting onedrive client..."
# Upload only, and never propagate local deletions: whatever happens inside this container,
# files already in OneDrive are kept (and overwritten files keep their OneDrive version history).
onedrive --monitor --upload-only --no-remote-delete $(resync_flags) "$@"
