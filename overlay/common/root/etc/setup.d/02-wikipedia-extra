#! /bin/bash

# Kept outside the web root so Apache can never serve it
INI=/var/www/config/ExtraLocalConfig.ini
if [ ! -e "$INI" ]; then

    while [[ "$SMTP_USER" != *@*.* ]]; do
        read -r -p "Enter the full Gmail address the wiki sends mail from (e.g. wiki@example.com): " SMTP_USER
    done
    [ -z "$SMTP_PASS" ] && read -r -s -p "Enter that account's Google app password (not the account password): " SMTP_PASS
    echo

    export SMTP_USER
    export SMTP_PASS
    cat <<- EOF > $INI
smtp_user = '$SMTP_USER'
smtp_pass = '$SMTP_PASS'
EOF
    chown root:www-data $INI
    chmod 0640 $INI
fi

function wait_file() {
    local file="$1"; shift
    until test -e "$file"; do sleep 1; done
}


FILE=/var/www/html/LocalSettings.php

(wait_file "$FILE" && {
    require="require 'ExtraLocalSettings.php';"
    if ! grep -q "$require" $FILE; then
        echo "$require" >> "$FILE"
    fi
}) &

